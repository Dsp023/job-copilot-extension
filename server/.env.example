# Job Seeker Copilot Backend Configuration

PORT=3001
NODE_ENV=development

# LLM Provider selection: "groq" | "gemini" | "openai" | "mock"
LLM_PROVIDER=groq

# Groq API Configuration (Ultra-fast inference)
# Get free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration (Optional alternative)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rate Limiting (15 minutes window, 60 requests max)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# When true, if API keys are missing or provider quota is exceeded,
# a realistic intelligent mock report is generated for seamless local testing.
ALLOW_MOCK_FALLBACK=true
